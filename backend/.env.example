# GitHub Personal Access Token (Optional for public repos, recommended to avoid rate limits)
GITHUB_TOKEN=

# OpenAI API Key (Required for text-embedding-3-small)
OPENAI_API_KEY=your_openai_api_key_here

# Vector DB Configuration (Default: chroma for zero-friction local storage)
VECTOR_DB_TYPE=chroma

# Optional Pinecone Configuration (if VECTOR_DB_TYPE=pinecone)
PINECONE_API_KEY=
PINECONE_INDEX_NAME=codecompass
